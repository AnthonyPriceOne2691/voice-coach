# Copy to .env and adjust paths for your Mac setup.

APP_ENV=development
LOG_LEVEL=INFO

# Server
HOST=127.0.0.1
PORT=8000

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_INTERVIEW=qwen2.5:14b-instruct
OLLAMA_MODEL_REVIEW=deepseek-r1:14b
OLLAMA_NUM_CTX=8192

# Local binaries / models (Phase 0 benchmark fills final paths)
WHISPER_CPP_BIN=/opt/homebrew/bin/whisper-cli
WHISPER_MODEL_PATH=../data/models/whisper/ggml-small.en.bin
PIPER_BIN=../data/models/piper/piper/piper
# Henry's voice. Alternatives: en_US-ryan-high.onnx (more natural, +0.7s/sentence),
# en_US-ryan-medium.onnx, en_US-lessac-medium.onnx
PIPER_VOICE_PATH=../data/models/piper/en_US-hfc_male-medium.onnx

# Storage
DATABASE_URL=sqlite+aiosqlite:///../data/sessions/app.db

# Темп речи Генри: 1.0 = нативный, больше = медленнее
PIPER_LENGTH_SCALE=1.15
